# Variables read by mapcl / LangChain. Export them in your shell; .env is git-ignored
# but not loaded automatically. Never commit real keys.

# Default model: DeepSeek V4.1 Flash (LangChain id "deepseek:deepseek-flash")
DEEPSEEK_API_KEY=
# Optional DeepSeek-compatible endpoint (default https://api.deepseek.com)
DEEPSEEK_API_BASE=

# Only for "openai:..." models
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LangChain "provider:model" for the CLI (default: deepseek:deepseek-flash)
MAPCL_MODEL=deepseek:deepseek-flash
# Reasoning effort for OpenAI reasoning models only (e.g. high); "none" otherwise
MAPCL_REASONING_EFFORT=none

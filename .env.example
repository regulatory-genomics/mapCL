# Variables read by clmap / LangChain. Export them in your shell; .env is git-ignored
# but not loaded automatically. Never commit real keys.
OPENAI_API_KEY=
# LangChain "provider:model" used by the CLI when --model is not given
CLMAP_MODEL=openai:gpt-4.1-mini
# Optional OpenAI-compatible endpoint (vLLM, Ollama, Azure proxy, ...)
CLMAP_BASE_URL=
